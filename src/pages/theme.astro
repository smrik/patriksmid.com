---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Website theme · Patrik Šmid">
  <h1>Website theme</h1>
  <p>Use Appearance in the navigation to preview the components in either palette.</p>
  <h2>Controls</h2>
  <form class="patrik-toolbar" action="https://github.com/smrik/patriksmid.com/search">
    <label for="query">Search the source</label>
    <input class="patrik-field" id="query" name="q" type="search" required />
    <button class="patrik-button">Search</button>
  </form>
  <h2>Link list</h2>
  <ul class="patrik-list">
    <li><a href="/theme/v2.css">Shared stylesheet</a></li>
    <li><a href="/theme/shell.css">Sidebar stylesheet</a></li>
    <li><a href="/theme/shell.js">Responsive navigation</a></li>
    <li><a href="/theme/v2.js">Theme switch</a></li>
    <li><a href="https://github.com/smrik/patriksmid.com/blob/main/docs/THEME.md">HTML examples and integration guide</a></li>
  </ul>
</BaseLayout>
<style>
  h1 { margin-block: 1rem; }
  h2 { font-size: 1.5rem; margin-block: 1.5rem .5rem; }
  .patrik-toolbar { margin-block: .75rem; }
</style>
