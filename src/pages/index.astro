---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const writing = await getCollection('writing');

const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestWriting = writing
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Patrik Šmid — Finance, AI & Systems"
  description="Patrik Šmid — finance professional exploring investing, artificial intelligence, and systems."
>
  <section class="hero">
    <p class="eyebrow">Finance · AI · Systems</p>

    <h1>Patrik Šmid</h1>

    <p class="intro">
      I work in finance and build things around investing, artificial intelligence,
      data, and the systems that connect them.
    </p>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <a href="/projects">All projects →</a>
    </div>

    <div class="entries">
      {
        featuredProjects.map((project) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{formatDate(project.data.date)}</span>
              <span>{project.data.status}</span>
            </div>

            <h2>{project.data.title}</h2>
            <p>{project.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Latest writing</p>
      <a href="/writing">All writing →</a>
    </div>

    <div class="entries">
      {
        latestWriting.map((entry) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{formatDate(entry.data.date)}</span>
              <span>{entry.data.category}</span>
            </div>

            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(5rem, 12vw, 10rem) 0;
    border-bottom: 1px solid var(--rule);
  }

  .hero h1 {
    margin-bottom: 2rem;
  }

  .intro {
    max-width: 720px;
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    line-height: 1.45;
  }

  .section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .section-heading > a {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entries {
    display: grid;
    gap: 0;
  }

  .entry {
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top-color: var(--ink);
  }

  .entry h2 {
    max-width: 800px;
    margin-bottom: 0.75rem;
  }

  .entry p {
    max-width: 700px;
    color: var(--muted);
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
</style>