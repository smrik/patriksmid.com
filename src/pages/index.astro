---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuartzPosts from '../components/QuartzPosts.astro';

const projects = await getCollection('projects');

const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const websites = [
  {
    title: 'Life in Rooms',
    href: 'https://life.patriksmid.com/',
    description: 'A browser game about the rooms and decisions that make up a life.',
  },
  {
    title: 'CFA Visual Lab',
    href: 'https://cfa.patriksmid.com/',
    description: 'Explore CFA topics with interactive visual explanations.',
  },
  {
    title: 'Keydojo',
    href: 'https://keydojo.patriksmid.com/',
    description: 'Practice keyboard skills in the browser.',
  },
  {
    title: 'Code Lab',
    href: 'https://code.patriksmid.com/',
    description: 'Solve Python challenges in the browser. ChatGPT sign-in required.',
  },
  {
    title: 'Song Duel',
    href: 'https://songs.patriksmid.com/',
    description: 'Compare songs in head-to-head matchups.',
  },
  {
    title: 'Slovenia Purchasing Power',
    href: 'https://slovenia-purchasing-power.smrik.chatgpt.site/',
    description: 'Explore purchasing power in Slovenia.',
  },
  {
    title: 'Vim Forge',
    href: 'https://vim.patriksmid.com/',
    description: 'Practice Vim in the browser.',
  },
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Patrik Šmid — Finance, AI & Systems"
  description="Patrik Šmid — finance professional exploring investing, artificial intelligence, and systems."
>
  <section class="hero">
    <p class="eyebrow">Finance · AI · Systems</p>

    <h1>Patrik Šmid</h1>

    <p class="intro">
      I work in finance and build things around investing, artificial intelligence,
      data, and the systems that connect them.
    </p>
  </section>

  <section class="section" id="websites" aria-labelledby="websites-title">
    <h2 id="websites-title">Websites</h2>
    <ul class="websites">
      {websites.map(({ title, href, description }) => (
        <li>
          <a href={href}>
            <h3>{title} <span aria-hidden="true">↗</span></h3>
            <p>{description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <a href="/projects">All projects →</a>
    </div>

    <div class="entries">
      {
        featuredProjects.map((project) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{formatDate(project.data.date)}</span>
              <span>{project.data.status}</span>
            </div>

            <h2><a href={`/projects/${project.id}`}>{project.data.title}</a></h2>
            <p>{project.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <QuartzPosts />
</BaseLayout>

<style>
  .hero {
    padding: clamp(5rem, 12vw, 10rem) 0;
    border-bottom: 1px solid var(--rule);
  }

  .hero h1 {
    margin-bottom: 2rem;
  }

  .intro {
    max-width: 720px;
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    line-height: 1.45;
  }

  .section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .websites {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .websites a {
    display: block;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .websites h3 {
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    color: var(--accent);
  }

  .websites a:hover h3 {
    text-decoration: underline;
  }

  .websites p {
    margin: 0;
    color: var(--muted);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .section-heading > a {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entries {
    display: grid;
    gap: 0;
  }

  .entry {
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top-color: var(--ink);
  }

  .entry h2 {
    max-width: 800px;
    margin-bottom: 0.75rem;
  }

  .entry p {
    max-width: 700px;
    color: var(--muted);
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
</style>
