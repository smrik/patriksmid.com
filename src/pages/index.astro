---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuartzPosts from '../components/QuartzPosts.astro';

const projects = await getCollection('projects');

const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const websites = [
  {
    title: 'Life in Rooms',
    href: 'https://life.patriksmid.com/',
    description: 'A browser game about daily routines.',
  },
  {
    title: 'CFA Visual Lab',
    href: 'https://cfa.patriksmid.com/',
    description: 'Interactive CFA study modules.',
  },
  {
    title: 'Vim Forge',
    href: 'https://vim.patriksmid.com/',
    description: 'Keyboard drills for Vim.',
  },
  {
    title: 'Code Lab',
    href: 'https://code.patriksmid.com/',
    description: 'Python challenges. ChatGPT sign-in required.',
  },
  {
    title: 'Song Duel',
    href: 'https://songs.patriksmid.com/',
    description: 'Choose between two songs.',
  },
  {
    title: 'Macro Data',
    href: 'https://data.patriksmid.com/',
    description: 'Slovenian purchasing power and GDP.',
  },
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Patrik Šmid"
  description="Websites, projects, and writing by Patrik Šmid."
  pageClass="home-page"
>
  <section class="section" id="websites" aria-labelledby="websites-title">
    <h1 id="websites-title">Websites</h1>
    <ul class="websites patrik-list">
      {websites.map(({ title, href, description }) => (
        <li>
          <a href={href}>
            <h3>{title}</h3>
            <p>{description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <QuartzPosts />

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <a href="/projects">All projects →</a>
    </div>

    <div class="entries">
      {
        featuredProjects.map((project) => (
          <article class="entry">
            <div class="entry-meta">
              <span>{formatDate(project.data.date)}</span>
              <span>{project.data.status}</span>
            </div>

            <h2><a href={`/projects/${project.id}`}>{project.data.title}</a></h2>
            <p>{project.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

</BaseLayout>

<style>
  .section { padding-block: 1.5rem; }
  #websites-title { margin: 0 0 .75rem; }
  .websites a { text-decoration: none; padding-block: .65rem; }
  .websites h3 { margin: 0; font-size: 1rem; font-weight: 600; }
  .websites a:hover h3 { text-decoration: underline; }
  .websites p { margin: .125rem 0 0; color: var(--muted); font: inherit; font-size: .9rem; }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .section-heading > a {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entries {
    display: grid;
    gap: 0;
  }

  .entry {
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top-color: var(--ink);
  }

  .entry h2 {
    max-width: 800px;
    margin-bottom: 0.75rem;
  }

  .entry p {
    max-width: 700px;
    color: var(--muted);
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
</style>
