---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Patrik Šmid — finance, AI, systems, and writing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="stylesheet" href="/theme/v1.css" />
    <title>{title}</title>
  </head>

  <body>
    <header class="patrik-sitebar">
      <div class="patrik-sitebar-inner">
        <a class="patrik-sitebar-brand" href="/">Patrik Šmid</a>

        <nav class="patrik-sitebar-links" aria-label="Primary navigation">
          <a href="/#websites">Websites</a>
          <a href="/projects">Projects</a>
          <a href="/writing">Writing</a>
          <a href="https://blog.patriksmid.com/">Blog</a>
          <a href="/flatbot">Flatbot</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="patrik-shell">
      <slot />
    </main>

    <footer class="site-footer patrik-shell">
      <span>Patrik Šmid</span>

      <div class="footer-links">
        <a href="https://www.linkedin.com/" rel="me">LinkedIn</a>
        <a href="https://github.com/smrik" rel="me">GitHub</a>
      </div>
    </footer>
  </body>
</html>
