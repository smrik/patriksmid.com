---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const {
  title,
  pageClass,
  description = 'Websites, projects, and writing by Patrik Šmid.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-patrik-color>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" data-patrik-theme-color />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script is:inline src="/theme/v2.js"></script>
    <link rel="stylesheet" href="/theme/v2.css" />
    <link rel="stylesheet" href="/theme/shell.css" />
    <script is:inline defer src="/theme/shell.js"></script>
    <title>{title}</title>
  </head>

  <body class={pageClass}>
    <header class="patrik-sitebar" data-patrik-shell>
      <div class="patrik-sitebar-inner">
        <a class="patrik-sitebar-brand" href="/">Patrik Šmid</a>

        <label class="patrik-theme-control">
          <span>Theme</span>
          <select class="patrik-field" data-patrik-theme>
            <option value="auto">System</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>

        <nav class="patrik-sitebar-links" aria-label="Primary navigation">
          <a href="/#websites">Websites</a>
          <a href="/projects">Projects</a>
          <a href="/writing">Writing</a>
          <a href="https://blog.patriksmid.com/">Blog</a>
          <a href="https://hub.patriksmid.com/">Personal</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="patrik-shell">
      <slot />
    </main>

    <footer class="site-footer patrik-shell">
      <span>Patrik Šmid</span>

      <div class="footer-links">
        <a href="https://www.linkedin.com/" rel="me">LinkedIn</a>
        <a href="https://github.com/smrik" rel="me">GitHub</a>
      </div>
    </footer>
  </body>
</html>
